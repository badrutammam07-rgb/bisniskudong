rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /units/{unitId} {
      allow read: if true;
      allow write: if isValidId(unitId);
    }

    match /deleted_units/{unitId} {
      allow read: if true;
      allow write: if isValidId(unitId);
    }

    match /metadata/{metaId} {
      allow read: if true;
      allow write: if isValidId(metaId);
    }

    match /test/{docId} {
      allow read: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
